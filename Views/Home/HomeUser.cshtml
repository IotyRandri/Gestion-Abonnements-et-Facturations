</script>

<!-- Script to show average spending in the months graph -->
<script>
	var ctx = document.getElementById('moyennedepensemois').getContext('2d');
	var myChart = new Chart(ctx, {
		type: 'line',
		data: {
			labels: @Json.Serialize(labels_moyenneDepense),
			datasets: [{
				label: 'Moyenne Prix',
				data: @Json.Serialize(data_moyenneDepense),
			}]
		},
		options: {
			scales: {
				y: {
					beginAtZero: true
				}
			},
			plugins: {
				title : {
					display: true,
					text: "Moyenne des dépenses dans les mois de cet année",
				}
			},
		}
	});
</script>
