<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestion et Facturation Abonnements</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projet_.NET_Core_M2_Devops_Mr_Naina.styles.css" asp-append-version="true" />
</head>
<body>

    

    <!-- Default Navbar-->
    <!-- NavBar Home (Index) -->
    @{
        if (!ViewData.ContainsKey("Navbar")) {

            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Logout">Gestion et Facturation Abonnements</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Register">Register</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>

    <!-- Admin Navbar -->
        }
        else if (ViewData["Navbar"] != null && ViewData["Navbar"].ToString().Equals("admin"))
        {
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Logout">Gestion et Facturation Abonnements</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="HomeAdmin">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">Users</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Abonnements
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Abonnement" asp-action="Index">Abonnements</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="StatutAbonnement" asp-action="Index">Statuts Abonnement</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="TypeAbonnement" asp-action="Index">Types Abonnement</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="AbonnementUsers" asp-action="Index">Abonnements Users</a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Facture" asp-action="Index">Factures</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="CommissionAnnulation" asp-action="Index">Comission Annulation</a>
                                </li>
                            </ul>
                            <!-- Right-aligned section -->
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-area="" asp-controller="Home" asp-action="Logout">Logout</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>

    <!-- User Navbar -->
        }
        else if (ViewData["Navbar"] != null && ViewData["Navbar"].ToString().Equals("user"))
        {
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Logout">Gestion et Facturation Abonnements</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="HomeUser">Home</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Abonnements
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="AbonnementUsers" asp-action="AjoutAbonnement">Ajouter un abonnement</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="AbonnementUsers" asp-action="AbonnementAVenir">Abonnement à venir</a>
                                        </li>
                                    </ul>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Facture" asp-action="FacturesUser">Factures/Transactions</a>
                                    </li>
                                </li>
                            </ul>
                            <!-- Right-aligned section -->
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-area="" asp-controller="Home" asp-action="Logout">Logout</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        }
        


    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Gestion et Facturation Abonnements
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
