@model Projet_.NET_Core_M2_Devops_Mr_Naina.Models.AbonnementUsers


@{
    ViewData["Title"] = "Ajout Abonnement";
}

<!-- Custom CSS for minimalistic styling -->
<style>

    .form-control, .form-select {
        border-radius: 0.375rem;
        border: 1px solid #ced4da;
        padding: 0.75rem 1.25rem;
        font-size: 1rem;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        transition: background-color 0.3s, border-color 0.3s;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }

    .alert {
        padding: 0.75rem 1.25rem;
        font-size: 1rem;
    }

    .form-group label {
        font-weight: 500;
    }

    .text-center {
        text-align: center;
    }

    /* Card style improvements with more defined borders */
    .form-card {
        background-color: #ffffff;
        border-radius: 8px;
        border: 2px solid rgba(0, 0, 0, 0.1); /* Semi-transparent black border */
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin: 20px;
    }

    /* Adding margin to separate the form from other content */
    .form-group {
        margin-bottom: 20px;
    }

        /* Button and form alignment */
        .form-group.text-center {
            margin-top: 20px;
        }

    /* Alert message style */
    .alert-success {
        font-size: 1.1rem;
        padding: 1rem 2rem;
        border-radius: 0.25rem;
    }
</style>


<div class="container mt-5">
    <div class="row justify-content-center">
        <h1 class="text-center mb-4"><u>Ajouter un Abonnement</u></h1>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg">
            <form asp-controller="AbonnementUsers" asp-action="AjoutAbonnement" method="post" class="form-card">
                <div class="form-group mb-4">
                    <label for="abonnementId" class="form-label">Abonnement</label>
                    <select name="abonnementId" class="form-select" asp-items="ViewBag.abonnements">
                        <option value="">Sélectionner un abonnement</option>
                    </select>
                    @Html.ValidationMessageFor(model => model.AbonnementId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group mb-4">
                    <label for="dateheuredebut" class="form-label">Date et Heure Début</label>
                    <input type="datetime-local" name="dateheuredebut" class="form-control" />
                    @Html.ValidationMessageFor(model => model.DateHeureDebut, "", new { @class = "text-danger" })
                </div>

                <div class="form-group text-center">
                    <input type="submit" class="btn btn-primary w-100 px-4 py-2" value="Ajouter" />
                </div>
            </form>
        </div>
    </div>

    <div class="row text-center mt-3">
        @if (ViewData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">
                @ViewData["SuccessMessage"];
            </div>
        }
        else if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["SuccessMessage"];
            </div>
        }
    </div>
</div>
