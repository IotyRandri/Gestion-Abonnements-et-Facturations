@model Projet_.NET_Core_M2_Devops_Mr_Naina.Models.AbonnementUsers

@{
	ViewData["Title"] = "Pdf";
	var user = ViewData["user"] as Users;
	var facture = ViewData["facture"] as Facture;
	var abonnements = ViewData["abonnementsUser"] as List<AbonnementUsers>;
}

<head>
    <style>
        /* Center the table within the page */
        .text-center {
            text-align: center;
        }

        .table {
            margin: 0 auto; /* Centers the table horizontally */
            width: 80%; /* Optional: Adjust width as needed */
            border-collapse: collapse; /* Ensures table borders collapse into a single line */
        }

        .table-bordered {
            border: 1px solid #ddd; /* Adds a light border to the table */
        }

        .table th, .table td {
            padding: 10px; /* Adds padding to cells */
            text-align: center; /* Centers the text within each cell */
            border: 1px solid #ddd; /* Adds a border to each cell */
        }

        .table th {
            background-color: #f2f2f2; /* Adds a light gray background to header */
            font-weight: bold; /* Makes the header text bold */
        }

        .table tr:nth-child(even) {
            background-color: #f9f9f9; /* Adds a striped effect */
        }

        .table tr:hover {
            background-color: #f1f1f1; /* Highlights row when hovered */
        }

        .table td[colspan="3"] {
            text-align: right; /* Aligns "Total" label to the right */
        }

    </style>
</head>

<div class="text-center">
    <div>
        <h1>Facture</h1>
    </div>
    <div>
        <div>
            <h2><u>Client</u>: @user.Nom @user.Prenom</h2>
        </div>
        <div>
            <h2><u>Adresse</u>: @user.Adresse</h2>
        </div>
        <div>
            <h2><u>Type Abonnement</u>: @facture.TypeAbonnement.Titre</h2>
        </div>
        <div>
            <h2><u>Date</u>: @facture.Dateheure.ToString("f", new System.Globalization.CultureInfo("fr-FR"))</h2>
        </div>
    </div>
    <div>
        <table id="table_abuser" class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Abonnement)</th>
                    <th>Date et Heure Début</th>
                    <th>Date et Heure Fin</th>
                    <th>Prix</th>
                    <th>Prix Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ab in abonnements)
                {
                    <tr>
                        <td>@ab.Abonnement.Nom</td>
                        <td>@ab.DateHeureDebut.ToString("f", new System.Globalization.CultureInfo("fr-FR"))</td>
                        <td>@ab.DateHeureFin.ToString("f", new System.Globalization.CultureInfo("fr-FR"))</td>
                        <td>@ab.Abonnement.Prix</td>
                        <td>@ab.PrixEstimation</td>
                    </tr>
                }
                <!-- Prix Total-->
                <tr>
                    <td colspan="2"></td>
                    <td><b>Total</b></td>
                    <td>@ViewData["prixtotal"]</td>
                    <td>@facture.Prixtotal</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

